# Servidor
PORT=3000
# Orígenes separados por coma; ajusta para desarrollo web y Capacitor.
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost,capacitor://localhost
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h

# Aiven for MySQL: copia los valores desde Overview > Connection information.
DB_HOST=tu-servicio.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=NO_PONGAS_TU_CONTRASENA_EN_GIT
# Descarga “CA Certificate” en Aiven y guárdalo solo localmente en certs/ca.pem.
DB_SSL_CA_PATH=certs/ca.pem

# Resend: solo para el servidor. En Render usa una API key con permiso Sending access.
RESEND_API_KEY=re_REEMPLAZA_CON_LA_CLAVE_DE_RESEND
# Remitente autorizado en Resend; usa un dominio verificado para producción.
EMAIL_FROM=Mi Negocio <onboarding@resend.dev>
